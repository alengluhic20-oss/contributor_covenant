{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MA'AT Lyapunov Trajectory Schema",
  "description": "Schema for PR trajectory data generated by the MA'AT system",
  "type": "object",
  "required": ["version", "timestamp", "repository", "trajectories"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of trajectory computation"
    },
    "repository": {
      "type": "object",
      "required": ["owner", "name"],
      "properties": {
        "owner": {
          "type": "string",
          "description": "Repository owner"
        },
        "name": {
          "type": "string",
          "description": "Repository name"
        },
        "full_name": {
          "type": "string",
          "description": "Full repository name (owner/name)"
        }
      }
    },
    "trajectories": {
      "type": "array",
      "description": "Array of PR trajectories",
      "items": {
        "type": "object",
        "required": ["pr_number", "state", "points"],
        "properties": {
          "pr_number": {
            "type": "integer",
            "minimum": 1,
            "description": "Pull request number"
          },
          "title": {
            "type": "string",
            "description": "PR title"
          },
          "state": {
            "type": "string",
            "enum": ["stable", "unstable", "critical", "in_flight", "merged", "closed"],
            "description": "Current PR state classification"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "PR creation timestamp"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Last update timestamp"
          },
          "author": {
            "type": "string",
            "description": "PR author username"
          },
          "points": {
            "type": "array",
            "description": "Trajectory data points",
            "items": {
              "type": "object",
              "required": ["timestamp", "score", "metrics"],
              "properties": {
                "timestamp": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Data point timestamp"
                },
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Overall Lyapunov stability score"
                },
                "metrics": {
                  "type": "object",
                  "required": [
                    "code_churn",
                    "review_engagement",
                    "conversation_sentiment",
                    "test_coverage",
                    "ci_stability",
                    "merge_conflicts"
                  ],
                  "properties": {
                    "code_churn": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "description": "Normalized code churn metric"
                    },
                    "review_engagement": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "description": "Normalized review engagement metric"
                    },
                    "conversation_sentiment": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "description": "Normalized sentiment metric"
                    },
                    "test_coverage": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "description": "Normalized test coverage metric"
                    },
                    "ci_stability": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "description": "Normalized CI stability metric"
                    },
                    "merge_conflicts": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "description": "Normalized merge conflict metric"
                    }
                  }
                },
                "velocity": {
                  "type": "object",
                  "description": "Rate of change in metrics",
                  "properties": {
                    "x": {
                      "type": "number",
                      "description": "X-axis velocity component"
                    },
                    "y": {
                      "type": "number",
                      "description": "Y-axis velocity component"
                    }
                  }
                }
              }
            }
          },
          "current_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Most recent stability score"
          },
          "trend": {
            "type": "string",
            "enum": ["improving", "stable", "declining"],
            "description": "Overall trajectory trend"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "description": "Aggregate statistics",
      "properties": {
        "total_prs": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of tracked PRs"
        },
        "stable_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of stable PRs"
        },
        "unstable_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of unstable PRs"
        },
        "critical_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of critical PRs"
        },
        "in_flight_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of in-flight PRs"
        },
        "average_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Average stability score"
        }
      }
    }
  }
}
